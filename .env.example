# v2 (Astro, branch main). Copy to .env.local. All optional; see README → Environment variables.

# Database (Neon pooled URL)
POSTGRES_URL=
# POSTGRES_URL_DIRECT=   # tooling only: db:pull and manual migrations

# GitHub (public-data token)
GITHUB_API_TOKEN=

# Now playing (Last.fm scrobbles of Spotify; see README)
LASTFM_API_KEY=
LASTFM_USERNAME=

# Buttondown
BUTTONDOWN_API_KEY=

# Token burn: key Claude Code sends with its OpenTelemetry metrics (Vercel: Production only)
TOKEN_BURN_INGEST_KEY=

# Giscus
NEXT_PUBLIC_GISCUS_REPO=
NEXT_PUBLIC_GISCUS_REPOSITORY_ID=
NEXT_PUBLIC_GISCUS_CATEGORY=
NEXT_PUBLIC_GISCUS_CATEGORY_ID=

# Umami
UMAMI_WEBSITE_ID=
