# All variables are optional: the site builds and runs without any of them,
# and each integration degrades gracefully when its variables are missing.
# Names are unchanged from v1, so the Vercel project needs no env changes.

# ── Server secrets (never sent to the browser) ───────────────────────────────

# Database: Postgres connection URL (post views and reactions)
POSTGRES_URL=
# Optional, tooling only (not read by the app): Neon direct host, i.e. the pooler hostname
# without `-pooler`, with sslmode=require. Used by `bun run db:pull` (introspection only).
# POSTGRES_URL_DIRECT=

# GitHub: personal access token (repository data on /projects, activity card)
GITHUB_API_TOKEN=

# Spotify: now playing track
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REFRESH_TOKEN=

# Buttondown: newsletter subscriptions
BUTTONDOWN_API_KEY=

# Anthropic: Admin API key for the Usage & Cost API (Token burn card)
ANTHROPIC_ADMIN_API_KEY=

# ── Public values (read on the server, rendered into pages) ───────────────────

# Giscus comments (https://giscus.app)
NEXT_PUBLIC_GISCUS_REPO=
NEXT_PUBLIC_GISCUS_REPOSITORY_ID=
NEXT_PUBLIC_GISCUS_CATEGORY=
NEXT_PUBLIC_GISCUS_CATEGORY_ID=

# Umami analytics
UMAMI_WEBSITE_ID=
