# karhdo.dev v2 (Astro + Bun) environment variables
#
# Setup:   cp .env.example .env.local   then fill in what you need (or `bunx vercel env pull .env.local`).
# Every variable is optional: the site builds and runs with none of them, and each feature shows a calm
# empty state when its variables are missing. Names are unchanged from v1 (no Vercel renames).
# Real env files are git-ignored; only this example is committed. Never put real values here.
#
# Which files are loaded (Vite/Astro rules, later wins):
#   bun dev                     .env  →  .env.local  →  .env.development  →  .env.development.local
#   bun dev --mode production   .env  →  .env.local  →  .env.production   →  .env.production.local
#   bun run build               same as --mode production
# On Vercel, values come from Project Settings → Environment Variables (Production / Preview / Development).
#
# Schema: `env.schema` in astro.config.mjs (read via `astro:env/server`; nothing reaches the browser
# except the public values rendered into pages).

# ── Database ──────────────────────────────────────────────────────────────────
# Neon Postgres, pooled connection (hostname contains `-pooler`), sslmode=require.
# Powers: post views + reactions (/api/stats), Blog stats card (/api/stats/summary, incl. the 30-day
# chart from `stats_daily`). ⚠ If this is the PRODUCTION database, every post you open locally
# records a real view. Use a Neon branch for local work when you can.
POSTGRES_URL=

# Tooling only, never read by the app: Neon DIRECT connection (the pooled hostname without
# `-pooler`). Used by `bun run db:pull` (introspection) and by `psql` for db/manual-migrations/.
# Always set it explicitly before db:pull (it otherwise falls back to POSTGRES_URL).
# POSTGRES_URL_DIRECT=

# ── GitHub ────────────────────────────────────────────────────────────────────
# Personal access token for PUBLIC data only: a classic token with no scopes, or a fine-grained
# token with read-only access to public repositories. https://github.com/settings/tokens
# Powers: repo stats on /projects and /api/github, the GitHub activity card + snake
# (/api/github/activity), and, at build time, the repo star count in the footer statusline.
GITHUB_API_TOKEN=

# ── Spotify (homepage "Now playing") ──────────────────────────────────────────
# App: https://developer.spotify.com/dashboard → your app → Settings (client ID / "View client secret").
# Refresh token: authorize your account once with the `user-read-currently-playing` scope and exchange
# the code for a refresh token. A refresh token only works with the app (client ID) that issued it.
# Troubleshooting (token endpoint errors):
#   invalid_client → the client ID/secret pair is wrong (secret rotated or app deleted): update both.
#   invalid_grant  → the refresh token was revoked/expired: authorize again for a new one.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REFRESH_TOKEN=

# ── Buttondown (newsletter) ───────────────────────────────────────────────────
# API key from https://buttondown.com/settings/api (subscriptions use double opt-in).
# Powers: POST /api/newsletter and the newsletter forms.
BUTTONDOWN_API_KEY=

# ── Anthropic (homepage "Token burn") ─────────────────────────────────────────
# Organization ADMIN key (sk-ant-admin…) for the Usage & Cost Admin API:
# https://console.anthropic.com → Settings → Admin keys.
# It can manage the whole org: set it in Vercel for PRODUCTION ONLY (not Preview/Development), ideally
# from a dedicated org. Covers API-key usage only (not Pro/Max plans); buckets are UTC days.
# Locally: add it to .env.local only if you want to see the card filled.
ANTHROPIC_ADMIN_API_KEY=

# ── Public values (read on the server, rendered into pages) ───────────────────
# Giscus comments: generate all four at https://giscus.app for the comments repo.
NEXT_PUBLIC_GISCUS_REPO=
NEXT_PUBLIC_GISCUS_REPOSITORY_ID=
NEXT_PUBLIC_GISCUS_CATEGORY=
NEXT_PUBLIC_GISCUS_CATEGORY_ID=

# Umami analytics: the website ID from your Umami dashboard (script is proxied at /stats/script.js).
UMAMI_WEBSITE_ID=

# ── Set automatically by Vercel: do not set by hand ───────────────────────────
# VERCEL, VERCEL_URL, VERCEL_BRANCH_URL (preview origins allowed by the /api/stats Origin check),
# VERCEL_GIT_COMMIT_SHA, VERCEL_GIT_COMMIT_REF (footer commit + branch at build time).
# Locally these fall back to git.

# ── v1 only: not read by v2 ───────────────────────────────────────────────────
# DATABASE_URL, POSTGRES_PRISMA_URL, POSTGRES_URL_NO_SSL, POSTGRES_URL_NON_POOLING, POSTGRES_HOST,
# POSTGRES_USER, POSTGRES_PASSWORD, POSTGRES_DATABASE, UTTERANCES_REPO, DISQUS_SHORTNAME,
# NEXT_PUBLIC_CREATE_DISCUS_ON_GITHUB, NEXT_PUBLIC_CREATE_DISCUS_ON_TWITTER,
# NEXT_PUBLIC_SHARE_ON_FACEBOOK, NEXT_PUBLIC_SHARE_ON_TWITTER.
# Keep them in Vercel while the v1 branch still deploys from the same project; v2 ignores them.
