---
/**
 * Umami analytics (v1 `components/analytics/umami.tsx`). The script is served through the
 * `/stats/*` rewrite in vercel.json. Umami tracks ClientRouter's history pushes itself, so the
 * tag must not re-run on swap (no `data-astro-rerun`). Emits nothing in dev or without an id.
 *
 * Link events use `data-track`, not `data-umami-event`: Umami cancels same-tab link clicks until the
 * event is sent, then does a full page load, which skips the ClientRouter and waits on the
 * analytics server. Here the event is sent without waiting and the click is left alone.
 */
import { UMAMI_WEBSITE_ID } from 'astro:env/server';

const websiteId = import.meta.env.PROD ? UMAMI_WEBSITE_ID : undefined;
---

{websiteId && <script is:inline defer src="/stats/script.js" data-website-id={websiteId} />}

<script>
  type Umami = { track: (name: string) => unknown };

  document.addEventListener(
    'click',
    (event) => {
      const name = (event.target as Element | null)?.closest<HTMLElement>('[data-track]')?.dataset.track;
      if (name) (window as unknown as { umami?: Umami }).umami?.track(name);
    },
    { capture: true }
  );
</script>
