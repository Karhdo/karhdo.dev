---
/** /about hero: a `neofetch` terminal card. Local time and uptime refresh in the browser. */
import { Image } from 'astro:assets';
import Button from '~/components/ui/Button.astro';
import Card from '~/components/ui/Card.astro';
import Icon, { type IconName } from '~/components/ui/Icon.astro';
import Twemoji from '~/components/ui/Twemoji.astro';
import { EXPERIENCES } from '~/config/experiences';
import { SITE } from '~/config/site';
import { type Author, getPublishedPosts } from '~/lib/content';
import { localAsset } from '~/lib/local-assets';
import { formatHcmTime } from '~/lib/utils/local-time';
import { formatUptime, parseMonthYear } from '~/lib/utils/month-year';

interface Props {
  author: Author['data'];
}

const { name, avatar, occupation, company, email, github, linkedin, twitter } = Astro.props.author;
const avatarAsset = localAsset(avatar);
const avatarClass = 'relative size-32 rounded-full bg-surface-solid object-cover p-1 sm:size-36';

const socials = [
  { icon: 'Mail', label: 'Email', href: email && `mailto:${email}` },
  { icon: 'Github', label: 'GitHub', href: github },
  { icon: 'Linkedin', label: 'LinkedIn', href: linkedin },
  { icon: 'Twitter', label: 'Twitter', href: twitter },
].filter((social): social is { icon: IconName; label: string; href: string } => Boolean(social.href));

const firstJob = EXPERIENCES.filter((e) => e.event !== 'career-uit')
  .map((e) => ({ label: e.start, date: parseMonthYear(e.start) }))
  .filter((e): e is { label: string; date: Date } => e.date !== null)
  .sort((a, b) => a.date.getTime() - b.date.getTime())[0];

const posts = (await getPublishedPosts()).length;
const now = new Date();

const rows: { key: string; value?: string }[] = [
  { key: 'Role', value: [occupation, company && `@ ${company}`].filter(Boolean).join(' ') },
  { key: 'Project' },
  { key: 'Location', value: SITE.location },
  { key: 'Local time' },
  { key: 'Uptime' },
  { key: 'Languages', value: 'JavaScript · TypeScript' },
  { key: 'Stack', value: 'NodeJS · ReactJS · Monorepo' },
  { key: 'Posts', value: `${posts} published` },
  { key: 'Theme', value: 'tokyonight (night / day)' },
];

const SWATCHES = ['red', 'orange', 'yellow', 'green', 'teal', 'cyan', 'blue', 'purple'];
---

<Card as="section" class="whoami overflow-hidden" aria-labelledby="whoami-name" data-card>
  <div class="wh-bar" aria-hidden="true">
    <span class="wh-dots"><i style="--dot: var(--red)"></i><i style="--dot: var(--yellow)"></i><i
        style="--dot: var(--green)"></i></span>
    <span class="wh-title">karhdo@hcmc: ~/about</span>
    <span class="wh-shell">zsh</span>
  </div>

  <div class="grid gap-7 p-5 sm:p-7 md:grid-cols-[auto_minmax(0,1fr)] md:gap-10">
    <div class="flex flex-col items-center gap-5 md:w-48">
      <div class="wh-avatar relative grid place-items-center">
        <span class="wh-ring loop-anim" aria-hidden="true"></span>
        {
          avatarAsset ? (
            <Image
              src={avatarAsset}
              alt={name}
              width={144}
              height={144}
              densities={[1, 2]}
              quality={75}
              loading="eager"
              class={avatarClass}
            />
          ) : (
            avatar && <img src={avatar} alt={name} width="144" height="144" class={avatarClass} />
          )
        }
      </div>
      <ul class="m-0 flex list-none gap-2 p-0">
        {
          socials.map(({ icon, label, href }) => (
            <li>
              <a
                href={href}
                {...(href.startsWith('mailto:') ? {} : { target: '_blank', rel: 'noopener noreferrer' })}
                class="wh-social grid size-10 place-items-center rounded-xl border border-line text-fg-soft hover:border-line-strong hover:text-blue focus-visible:border-line-strong focus-visible:text-blue"
                aria-label={label}
              >
                <Icon name={icon} size={18} />
              </a>
            </li>
          ))
        }
      </ul>
      <Button href="/static/resume.pdf" target="_blank" rel="noopener" class="w-full">
        <span>Resume</span>
        <Twemoji emoji="page-facing-up" size="base" />
      </Button>
    </div>

    <div class="wh-term min-w-0 font-mono text-[13.5px] leading-[1.75]">
      <p class="m-0 text-fg-soft" aria-hidden="true">
        <span class="wh-user">karhdo</span>@<span class="wh-host">hcmc</span>
        <span class="wh-path">~</span>
        <span class="wh-dollar">$</span>
        <span class="wh-cmd">neofetch</span>
      </p>

      <h2 id="whoami-name" class="wh-head m-0 mt-3 font-sans font-bold text-2xl text-fg tracking-[-0.02em] sm:text-[1.75rem]">
        {name} <span class="font-medium text-fg-soft">aka</span> <span class="wh-grad">Karhdo</span>
      </h2>
      <span class="wh-rule" aria-hidden="true"></span>

      <dl class="m-0 grid grid-cols-[auto_minmax(0,1fr)] gap-x-5">
        {
          rows.map(({ key, value }, i) => (
            <div class="wh-row contents" style={`--i: ${i}`}>
              <dt class="wh-key">{key}</dt>
              <dd class="m-0 min-w-0 text-fg-soft">
                {key === 'Project' ? (
                  <>
                    <b class="font-semibold text-fg">LoanBud</b> · business financing platform
                  </>
                ) : key === 'Local time' ? (
                  <>
                    <span class="wh-live" aria-hidden="true" />
                    <time data-hcm-time datetime={now.toISOString()}>
                      {formatHcmTime(now, SITE.timezone)}
                    </time>{' '}
                    <span data-hcm-diff>· UTC+7</span>
                  </>
                ) : key === 'Uptime' ? (
                  firstJob && (
                    <>
                      <b class="font-semibold text-fg" data-uptime-from={firstJob.label}>
                        {formatUptime(firstJob.date, now)}
                      </b>{' '}
                      writing code for a living, since {firstJob.label}
                    </>
                  )
                ) : (
                  value
                )}
              </dd>
            </div>
          ))
        }
      </dl>

      <div class="wh-palette mt-5 flex" aria-hidden="true">
        {SWATCHES.map((tone) => <span style={`--sw: var(--${tone})`} />)}
      </div>

      <p class="m-0 mt-4 text-fg-soft" aria-hidden="true">
        <span class="wh-user">karhdo</span>@<span class="wh-host">hcmc</span>
        <span class="wh-path">~</span>
        <span class="wh-dollar">$</span>
        <span class="wh-caret loop-anim"></span>
      </p>
    </div>
  </div>
</Card>

<style>
  .wh-bar {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    padding: 10px 16px;
    border-bottom: 1px solid var(--line);
    font-family: var(--font-mono);
    font-size: 12px;
  }
  .wh-dots {
    display: flex;
    gap: 7px;
  }
  .wh-dots i {
    width: 11px;
    height: 11px;
    border-radius: 50%;
    background: color-mix(in srgb, var(--dot) 80%, transparent);
  }
  .wh-title {
    color: var(--fg-soft);
  }
  .wh-shell {
    justify-self: end;
    color: var(--muted);
  }

  .wh-ring {
    position: absolute;
    inset: -4px;
    border-radius: 50%;
    background: conic-gradient(from 0deg, var(--blue), var(--cyan), var(--blue1), var(--blue));
    box-shadow: 0 0 28px color-mix(in srgb, var(--blue) 35%, transparent);
  }

  .wh-user {
    color: light-dark(color-mix(in srgb, var(--green) 60%, var(--fg)), var(--green));
  }
  .wh-host {
    color: light-dark(color-mix(in srgb, var(--blue) 60%, var(--fg)), var(--blue));
  }
  .wh-path {
    color: light-dark(color-mix(in srgb, var(--cyan) 60%, var(--fg)), var(--cyan));
  }
  .wh-dollar {
    color: var(--fg);
  }
  /* compressHTML drops the whitespace between these spans. */
  .wh-path,
  .wh-dollar,
  .wh-cmd,
  .wh-caret {
    margin-left: 1ch;
  }
  .wh-cmd {
    display: inline-block;
    color: var(--fg);
  }
  .wh-grad {
    background-image: linear-gradient(100deg, var(--blue) 0%, var(--cyan) 50%, var(--blue) 100%);
    background-clip: text;
    -webkit-background-clip: text;
    color: transparent;
  }
  .wh-rule {
    display: block;
    width: 100%;
    max-width: 22rem;
    margin: 8px 0 12px;
    border-top: 1px dashed var(--line-strong);
  }
  .wh-key {
    font-weight: 600;
    color: light-dark(color-mix(in srgb, var(--blue) 60%, var(--fg)), var(--blue));
  }
  .wh-live {
    display: inline-block;
    width: 7px;
    height: 7px;
    margin-right: 7px;
    vertical-align: 0.1em;
    border-radius: 50%;
    background: var(--green);
  }
  .wh-palette span {
    width: 26px;
    height: 14px;
    background: var(--sw);
  }
  .wh-palette span:first-child {
    border-radius: 4px 0 0 4px;
  }
  .wh-palette span:last-child {
    border-radius: 0 4px 4px 0;
  }
  .wh-caret {
    display: inline-block;
    width: 0.6em;
    height: 1.1em;
    vertical-align: -0.2em;
    background: var(--fg-soft);
  }

  @media (max-width: 520px) {
    .wh-title {
      display: none;
    }
    .wh-term dl {
      grid-template-columns: minmax(0, 1fr);
    }
    .wh-term dd {
      margin-bottom: 6px;
    }
    .wh-key {
      font-size: 11.5px;
      letter-spacing: 0.04em;
      text-transform: uppercase;
    }
    .wh-bar {
      grid-template-columns: 1fr auto;
    }
  }

  @media (prefers-reduced-motion: no-preference) {
    .wh-cmd {
      animation-name: whType;
      animation-duration: 0.55s;
      animation-timing-function: steps(8, end);
      animation-delay: 0.25s;
      animation-fill-mode: backwards;
    }
    .wh-head,
    .wh-rule,
    .wh-row > *,
    .wh-palette {
      animation-name: whLine;
      animation-duration: 0.45s;
      animation-timing-function: var(--ease-out);
      animation-fill-mode: backwards;
      animation-delay: 0.85s;
    }
    .wh-rule {
      animation-delay: 0.9s;
    }
    .wh-row > * {
      animation-delay: calc(0.95s + var(--i, 0) * 60ms);
    }
    .wh-palette {
      animation-delay: 1.55s;
    }
    .wh-ring {
      animation: whSpin 9s linear infinite;
    }
    .wh-caret {
      animation: whBlink 1.1s steps(1) infinite;
    }
    .wh-social {
      transition:
        border-color 0.2s,
        color 0.2s,
        translate 0.2s var(--ease-spring);
    }
    .wh-social:hover {
      translate: 0 -2px;
    }
  }

  @keyframes whType {
    from {
      clip-path: inset(0 100% 0 0);
    }
    to {
      clip-path: inset(0 0 0 0);
    }
  }
  @keyframes whLine {
    from {
      opacity: 0;
      translate: -6px 0;
    }
  }
  @keyframes whSpin {
    to {
      rotate: 1turn;
    }
  }
  @keyframes whBlink {
    50% {
      opacity: 0;
    }
  }
</style>

<script>
  import { formatUptime, parseMonthYear } from '~/lib/utils/month-year';

  document.addEventListener('astro:page-load', () => {
    const now = new Date();
    for (const el of document.querySelectorAll<HTMLElement>('[data-uptime-from]')) {
      const start = parseMonthYear(el.dataset.uptimeFrom ?? '');
      if (start) el.textContent = formatUptime(start, now);
    }
  });
</script>
