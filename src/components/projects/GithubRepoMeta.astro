---
/**
 * GitHub repo facts in a project card's `meta` slot on /projects (task 20, port of v1
 * `components/project/GithubRepo.tsx`): top 3 languages with dots, forks, then topics. Stars are
 * shown by ProjectCard's eyebrow (`★ n`, as in the mockup), so they are not repeated here.
 * Language dots use Tokyonight tones (`languageTone`) instead of GitHub's brand hexes.
 * Rendered on the server from `fetchRepoData`; /projects omits it when the data is `null`.
 */
import Icon from '~/components/ui/Icon.astro';
import { languageTone } from '~/lib/github-repo';
import type { GithubRepository } from '~/types/github';

interface Props {
  repo: GithubRepository;
}

const { repo } = Astro.props;
const languages = repo.languages.slice(0, 3);
const topics = repo.repositoryTopics.slice(0, 6);
const count = (value: number) => value.toLocaleString('en-US');
---

<div class="repo-meta">
  <ul class="facts" aria-label="GitHub repository">
    {
      languages.map((language) => (
        <li>
          <span class="dot" style={`background: var(--${languageTone(language.name)})`} aria-hidden="true" />
          {language.name}
        </li>
      ))
    }
    <li>
      <Icon name="GitFork" size={14} />
      <span class="sr-only">Forks:</span>
      {count(repo.forkCount)}
    </li>
  </ul>
  {
    topics.length > 0 && (
      <ul class="topics" aria-label="Topics">
        {topics.map((topic) => (
          <li>#{topic}</li>
        ))}
      </ul>
    )
  }
</div>

<style>
  .repo-meta {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }
  ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
  }
  .facts {
    gap: 6px 16px;
    font-family: var(--font-mono);
    font-size: 12.5px;
    color: var(--fg-soft);
  }
  .facts li {
    display: inline-flex;
    align-items: center;
    gap: 6px;
  }
  .dot {
    width: 9px;
    height: 9px;
    border-radius: 50%;
    flex-shrink: 0;
  }
  .topics {
    gap: 6px;
  }
  /* Tone mixed toward --fg so the small text passes AA on its tint in both themes. */
  .topics li {
    font-family: var(--font-mono);
    font-size: 11.5px;
    padding: 2px 8px;
    border-radius: 999px;
    color: color-mix(in srgb, var(--blue) 55%, var(--fg));
    background: color-mix(in srgb, var(--blue) 10%, transparent);
  }
</style>
