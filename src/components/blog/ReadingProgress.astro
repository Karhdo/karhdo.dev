---
/**
 * Reading progress (mockup `.readbar`): a fixed 3px bar scaled on X by how far the article
 * (`[data-reading-target]`) has been read, 100 % when its end reaches the bottom of the viewport.
 * Driven by `scroll` + `requestAnimationFrame`; shown under reduced motion too, without easing.
 */
---

<div
  data-reading-progress
  role="progressbar"
  aria-label="Reading progress"
  aria-valuemin="0"
  aria-valuemax="100"
  aria-valuenow="0"
  class="readbar pointer-events-none fixed inset-x-0 top-0 z-[60] h-[3px]"
>
</div>

<style>
  .readbar {
    background: linear-gradient(90deg, var(--blue), var(--purple), var(--cyan));
    transform: scaleX(0);
    transform-origin: 0 50%;
  }

  @media (prefers-reduced-motion: no-preference) {
    .readbar {
      transition: transform 80ms linear;
    }
  }
</style>

<script>
  let frame = 0;
  let onScroll: (() => void) | undefined;

  function stop() {
    if (onScroll) {
      window.removeEventListener('scroll', onScroll);
      window.removeEventListener('resize', onScroll);
    }
    cancelAnimationFrame(frame);
    onScroll = undefined;
  }

  function initReadingProgress() {
    stop();
    const bar = document.querySelector<HTMLElement>('[data-reading-progress]');
    const article = document.querySelector<HTMLElement>('[data-reading-target]');
    if (!bar || !article) return;

    let last = -1;
    const render = () => {
      frame = 0;
      const rect = article.getBoundingClientRect();
      const total = rect.height - window.innerHeight;
      const progress = total <= 0 ? 1 : Math.min(1, Math.max(0, -rect.top / total));
      const percent = Math.round(progress * 100);
      bar.style.transform = `scaleX(${progress})`;
      if (percent !== last) {
        last = percent;
        bar.setAttribute('aria-valuenow', String(percent));
      }
    };
    onScroll = () => {
      if (!frame) frame = requestAnimationFrame(render);
    };
    window.addEventListener('scroll', onScroll, { passive: true });
    window.addEventListener('resize', onScroll, { passive: true });
    render();
  }

  document.addEventListener('astro:page-load', initReadingProgress);
  document.addEventListener('astro:before-swap', stop);
</script>
