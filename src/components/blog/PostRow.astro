---
/**
 * One blog-list row (mockup `.post-row`): ISO date · title + summary + tag pills · reading time.
 * The whole row is a single link, so tags are plain spans (tag links live in the chip bar).
 * The title carries `post-title-{id}` so it morphs into the post page `<h1>` (task 12).
 */
import { isoDate, readingMinutes } from '~/lib/blog-list';
import { getReadingTime, type Post, postUrl } from '~/lib/content';
import { tagSlug } from '~/lib/tags';

interface Props {
  post: Post;
  /** Heading level of the title: 2 under a page `<h1>` (blog/tags), 3 under a section `<h2>` (homepage). */
  headingLevel?: 2 | 3;
}

const { post, headingLevel = 2 } = Astro.props;
const { title, summary, tags, date } = post.data;
const iso = isoDate(date);
const minutes = readingMinutes(getReadingTime(post.body ?? '').minutes);
const Heading = headingLevel === 3 ? 'h3' : 'h2';
---

<a class="post-row" href={postUrl(post)}>
  <time datetime={iso}>{iso}</time>
  <div class="body">
    <Heading class="title vt-post-title" transition:name={`post-title-${post.id}`}><span class="line">{title}</span></Heading>
    {summary && <p class="summary">{summary}</p>}
    {
      tags.length > 0 && (
        <div class="tags">
          {tags.map((tag) => (
            <span class="tag">
              <span class="hash" aria-hidden="true">#</span>
              {tagSlug(tag)}
            </span>
          ))}
        </div>
      )
    }
  </div>
  <span class="meta"><span>{minutes} min<span class="sr-only"> read</span></span><span class="arrow" aria-hidden="true">→</span></span>
</a>

<style>
  .post-row {
    display: grid;
    grid-template-columns: 110px minmax(0, 1fr) auto;
    gap: 20px;
    align-items: baseline;
    margin-inline: -12px;
    padding: 22px 12px;
    border-top: 1px solid var(--line);
    border-radius: 12px;
    color: var(--fg);
    text-decoration: none;
    transition:
      background-color 0.2s,
      box-shadow 0.2s;
  }
  .post-row:hover,
  .post-row:focus-visible {
    background: var(--surface);
    box-shadow: inset 0 0 0 1px var(--line);
    -webkit-backdrop-filter: blur(14px) saturate(140%);
    backdrop-filter: blur(14px) saturate(140%);
  }
  .post-row:focus-visible {
    outline: 2px solid var(--blue);
    outline-offset: 2px;
  }
  time {
    font-family: var(--font-mono);
    font-size: 13px;
    color: var(--fg-soft);
    font-variant-numeric: tabular-nums;
  }
  .title {
    margin: 0 0 6px;
    font-size: 20px;
    font-weight: 600;
    line-height: 1.3;
    letter-spacing: -0.015em;
    text-wrap: balance;
    transition: color 0.2s;
  }
  .post-row:hover .title,
  .post-row:focus-visible .title {
    color: var(--blue);
  }
  .summary {
    margin: 0 0 8px;
    color: var(--fg-soft);
    font-size: 15px;
  }
  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
  }
  .tag {
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--fg-soft);
  }
  .hash {
    color: var(--purple);
  }
  .meta {
    display: inline-flex;
    align-items: baseline;
    gap: 6px;
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--fg-soft);
    white-space: nowrap;
  }
  .arrow {
    display: inline-block;
    color: var(--faint);
    transition: color 0.2s;
  }
  .post-row:hover .arrow,
  .post-row:focus-visible .arrow {
    color: var(--blue);
  }

  @media (prefers-reduced-motion: no-preference) {
    /* Title underline grows from the left; arrow nudges right. Transform/background only: no layout shift. */
    .line {
      background: linear-gradient(currentColor, currentColor) 0 100% / 0 1.5px no-repeat;
      transition: background-size 0.35s var(--ease-out);
    }
    .post-row:hover .line,
    .post-row:focus-visible .line {
      background-size: 100% 1.5px;
    }
    .arrow {
      transition:
        transform 0.35s var(--ease-out),
        color 0.2s;
    }
    .post-row:hover .arrow,
    .post-row:focus-visible .arrow {
      transform: translateX(4px);
    }
  }

  @media (max-width: 600px) {
    .post-row {
      grid-template-columns: minmax(0, 1fr);
      gap: 6px;
    }
    .meta {
      display: none;
    }
  }
</style>
