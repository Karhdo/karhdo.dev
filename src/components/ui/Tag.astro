---
/** Post tag (mockup `.tag`): `#text` linking to `/tags/{slug}` (github-slugger, same as v1). */
import { slug } from 'github-slugger';
import { cn } from '~/lib/utils/cn';

interface Props {
  text: string;
  class?: string;
}

const { text, class: className } = Astro.props;
---

<a
  href={`/tags/${slug(text)}`}
  class={cn(
    'font-mono text-purple text-xs no-underline underline-offset-4 hover:underline focus-visible:underline',
    className
  )}
><span class="opacity-60" aria-hidden="true">#</span>{text.split(' ').join('-')}</a>
