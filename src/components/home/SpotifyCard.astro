---
/**
 * Bento "Now playing" card (mockup `.c-spotify`, task 19). A plain module script (no React island,
 * like the task-18 stats): the card fetches `GET /api/spotify` (Last.fm scrobbles of my Spotify
 * listening) once it scrolls into view, then every 30 s while it is on screen and the tab is visible.
 * Playing: "Now playing", artist · album. Otherwise the API sends the last played track (`playedAt`):
 * "Last played", artist · relative time. Last.fm has no playback position, so there is no progress bar.
 * The equaliser bars animate only while playing and with motion allowed. Skeleton, playing, last-played
 * and offline states share one fixed layout inside the reserved `CARD_MIN_HEIGHT.spotify`, so nothing shifts. `transition:persist` keeps
 * the last state across view-transition navigations back to the homepage.
 * The grid span, `.rise` and `--i` come from `index.astro` through `class` / `style`.
 */
import Card from '~/components/ui/Card.astro';
import SimpleIcon from '~/components/ui/SimpleIcon.astro';
import { cn } from '~/lib/utils/cn';
import CardEyebrow from './CardEyebrow.astro';
import CardSkeleton from './CardSkeleton.astro';
import { CARD_MIN_HEIGHT } from './card-sizes';

interface Props {
  class?: string;
  style?: string;
}

const { class: className, style } = Astro.props;
---

<Card
  class={cn('flex flex-col gap-3.5', className)}
  style={`min-height: ${CARD_MIN_HEIGHT.spotify}px; ${style ?? ''}`}
  data-tilt
  data-spotify-card
  aria-busy="true"
  transition:persist="spotify"
>
  <CardEyebrow>
    <span class="sp-bars loop-anim" data-sp-bars aria-hidden="true"><i></i><i></i><i></i><i></i></span>
    <span data-sp-label>Now playing</span>
  </CardEyebrow>

  <div class="contents" data-sp-skeleton>
    <div class="flex items-center gap-3">
      <CardSkeleton height={56} width="56px" radius="10px" />
      <div class="flex flex-1 flex-col gap-2">
        <CardSkeleton height={14} width="70%" />
        <CardSkeleton height={12} width="50%" />
      </div>
    </div>
  </div>

  <div class="contents" data-sp-body hidden>
    <div class="flex min-w-0 items-center gap-3">
      <div class="relative size-14 shrink-0 overflow-hidden rounded-[10px]" aria-hidden="true">
        <span class="sp-cover absolute inset-0" data-sp-cover></span>
        <span class="absolute inset-0 grid place-items-center bg-line text-spotify" data-sp-offline hidden>
          <SimpleIcon slug="spotify" size={28} />
        </span>
        <img
          class="absolute inset-0 size-full object-cover"
          data-sp-img
          width="56"
          height="56"
          sizes="56px"
          alt=""
          loading="lazy"
          decoding="async"
          referrerpolicy="no-referrer"
          hidden
        />
      </div>
      <div class="flex min-w-0 flex-1 flex-col">
        {/* A `<span>` until there is a song URL; the script swaps in an `<a>` (never an `<a>` without `href`). */}
        <span class="truncate font-semibold text-fg leading-[1.25] no-underline" data-sp-title></span>
        <p class="m-0 truncate text-fg-soft text-sm" data-sp-sub></p>
      </div>
    </div>
  </div>
</Card>

<style>
  /* Mockup `.bars`: static at 40 % until playing; v1 `music-bar-1..4` keyframes (animations.css). */
  .sp-bars {
    display: flex;
    gap: 3px;
    align-items: flex-end;
    height: 14px;
  }
  .sp-bars i {
    width: 3px;
    height: 40%;
    border-radius: 2px;
    background: var(--spotify);
  }
  @media (prefers-reduced-motion: no-preference) {
    .sp-bars[data-on] i {
      animation-duration: 0.8s;
      animation-timing-function: linear;
      animation-iteration-count: infinite;
    }
    .sp-bars[data-on] i:nth-child(1) {
      animation-name: music-bar-1;
    }
    .sp-bars[data-on] i:nth-child(2) {
      animation-name: music-bar-2;
    }
    .sp-bars[data-on] i:nth-child(3) {
      animation-name: music-bar-3;
    }
    .sp-bars[data-on] i:nth-child(4) {
      animation-name: music-bar-4;
    }
  }
  /* Mockup `.cover`: the placeholder when there is no album art. */
  .sp-cover {
    background: conic-gradient(from 200deg, var(--orange), var(--red), var(--purple), var(--blue), var(--orange));
  }
  .sp-cover::after {
    content: '';
    position: absolute;
    inset: 22px;
    border-radius: 50%;
    background: var(--surface-solid);
  }
</style>

<script>
  import { NOT_PLAYING } from '~/lib/now-playing';
  import { formatRelative } from '~/lib/utils/relative-time';
  import type { NowPlayingData } from '~/types/now-playing';

  const POLL_MS = 30_000;
  /** Attributes that belong only on the `<a>` form of the title. */
  const LINK_ATTRS = ['href', 'title', 'target', 'rel', 'data-umami-event'];

  class NowPlayingCard {
    readonly #root: HTMLElement;
    readonly #el: {
      bars: HTMLElement;
      label: HTMLElement;
      skeleton: HTMLElement;
      body: HTMLElement;
      cover: HTMLElement;
      offline: HTMLElement;
      img: HTMLImageElement;
      title: HTMLElement;
      sub: HTMLElement;
    };
    #data: NowPlayingData | undefined;
    #lastFetch = Number.NEGATIVE_INFINITY;
    #inflight = false;
    #inView = false;
    #poll: ReturnType<typeof setTimeout> | undefined;
    #io: IntersectionObserver | undefined;
    readonly #onVisibility = () => this.#sync();

    constructor(root: HTMLElement) {
      this.#root = root;
      const q = <T extends HTMLElement>(name: string) => root.querySelector<T>(`[data-sp-${name}]`) as T;
      this.#el = {
        bars: q('bars'),
        label: q('label'),
        skeleton: q('skeleton'),
        body: q('body'),
        cover: q('cover'),
        offline: q('offline'),
        img: q<HTMLImageElement>('img'),
        title: q('title'),
        sub: q('sub'),
      };
      this.#el.img.addEventListener('error', () => {
        this.#el.img.hidden = true;
        this.#el.cover.hidden = false;
      });
    }

    resume() {
      this.#io ??= new IntersectionObserver(([entry]) => {
        this.#inView = entry?.isIntersecting ?? false;
        this.#sync();
      });
      this.#io.observe(this.#root);
      document.addEventListener('visibilitychange', this.#onVisibility);
    }

    pause() {
      this.#io?.disconnect();
      this.#inView = false;
      document.removeEventListener('visibilitychange', this.#onVisibility);
      this.#sync();
    }

    /** Timers run only while the card is on screen and the tab is visible. */
    #sync() {
      const active = this.#inView && document.visibilityState === 'visible';
      if (!active) {
        clearTimeout(this.#poll);
        this.#poll = undefined;
        return;
      }
      if (performance.now() - this.#lastFetch >= POLL_MS) void this.#fetch();
      else if (this.#poll === undefined) this.#schedule(POLL_MS - (performance.now() - this.#lastFetch));
    }

    #schedule(delay: number) {
      clearTimeout(this.#poll);
      this.#poll = setTimeout(() => {
        this.#poll = undefined;
        void this.#fetch();
      }, delay);
    }

    async #fetch() {
      if (this.#inflight) return;
      this.#inflight = true;
      this.#lastFetch = performance.now();
      try {
        // Always ask the network (the route also sends `max-age=0, must-revalidate`); the Vercel CDN
        // copy still answers most polls.
        const response = await fetch('/api/spotify', { cache: 'no-cache', signal: AbortSignal.timeout(8000) });
        if (!response.ok) throw new Error(String(response.status));
        this.#data = (await response.json()) as NowPlayingData;
      } catch {
        this.#data ??= NOT_PLAYING; // keep the last good state on a transient error
      } finally {
        this.#inflight = false;
      }
      this.#render();
      if (this.#inView && document.visibilityState === 'visible') this.#schedule(POLL_MS);
    }

    #hasTrack(data: NowPlayingData | undefined): data is NowPlayingData & { title: string } {
      return Boolean(data?.title);
    }

    #render() {
      const data = this.#data;
      const el = this.#el;
      el.skeleton.hidden = true;
      el.body.hidden = false;
      this.#root.setAttribute('aria-busy', 'false');

      if (!this.#hasTrack(data)) {
        el.bars.removeAttribute('data-on');
        el.label.textContent = 'Now playing';
        el.img.hidden = true;
        el.cover.hidden = true;
        el.offline.hidden = false;
        this.#setTitle('Not playing');
        el.sub.textContent = 'Offline · Spotify';
        return;
      }

      el.bars.toggleAttribute('data-on', data.isPlaying);
      el.label.textContent = data.isPlaying ? 'Now playing' : 'Last played';
      el.offline.hidden = true;
      if (data.albumImageUrl) {
        if (el.img.getAttribute('src') !== data.albumImageUrl) {
          if (data.albumImageSrcset) el.img.srcset = data.albumImageSrcset;
          else el.img.removeAttribute('srcset');
          el.img.src = data.albumImageUrl;
        }
        el.img.hidden = false;
        el.cover.hidden = true;
      } else {
        el.img.hidden = true;
        el.cover.hidden = false;
      }
      const sub = [data.artist, data.album].filter(Boolean).join(' · ');
      this.#setTitle(data.title, data.songUrl, sub ? `${data.title} — ${sub}` : data.title);
      // The last played track trades the album for when it was played.
      const when = data.playedAt ? formatRelative(data.playedAt) : null;
      el.sub.textContent = when ? [data.artist, when].filter(Boolean).join(' · ') : sub || 'Spotify';
    }

    /** The title is a link only when there is a song URL (Lighthouse `crawlable-anchors`). */
    #setTitle(text: string, href?: string, tooltip?: string) {
      let title = this.#el.title;
      const tag = href ? 'A' : 'SPAN';
      if (title.tagName !== tag) {
        const next = document.createElement(tag.toLowerCase());
        // Keep every attribute (class, data-sp-title, Astro's scoped-style data-astro-cid-*) except the link ones.
        for (const { name, value } of title.attributes) {
          if (!LINK_ATTRS.includes(name)) next.setAttribute(name, value);
        }
        if (href) {
          next.dataset.umamiEvent = 'spotify-now-playing';
          next.setAttribute('target', '_blank');
          next.setAttribute('rel', 'noopener noreferrer');
        }
        title.replaceWith(next);
        this.#el.title = next;
        title = next;
      }
      if (href) title.setAttribute('href', href);
      title.classList.toggle('hover:underline', Boolean(href));
      if (tooltip) title.title = tooltip;
      else title.removeAttribute('title');
      title.textContent = text;
    }
  }

  const cards = new WeakMap<HTMLElement, NowPlayingCard>();

  function init() {
    for (const root of document.querySelectorAll<HTMLElement>('[data-spotify-card]')) {
      let card = cards.get(root);
      if (root.dataset.bound !== 'true' || !card) {
        root.dataset.bound = 'true';
        card = new NowPlayingCard(root);
        cards.set(root, card);
      }
      card.resume();
    }
  }

  // The card is `transition:persist`ed: stop its timers when leaving the page, resume on return.
  document.addEventListener('astro:before-swap', () => {
    for (const root of document.querySelectorAll<HTMLElement>('[data-spotify-card]')) cards.get(root)?.pause();
  });
  document.addEventListener('astro:page-load', init);
</script>
