---
/**
 * Bento "Now playing" card (mockup `.c-spotify`).
 * <!-- filled by task 19 --> Task 19 replaces the body with the `SpotifyNowPlaying` island
 * (`GET /api/spotify`). Until then a fixed-size skeleton keeps the final height (no CLS).
 * The grid span, `.rise` and `--i` come from `index.astro` through `class` / `style`.
 */
import Card from '~/components/ui/Card.astro';
import { cn } from '~/lib/utils/cn';
import CardEyebrow from './CardEyebrow.astro';
import CardSkeleton from './CardSkeleton.astro';
import { CARD_MIN_HEIGHT } from './card-sizes';

interface Props {
  class?: string;
  style?: string;
}

const { class: className, style } = Astro.props;
---

<!-- filled by task 19 -->
<Card
  class={cn('flex flex-col gap-3.5', className)}
  style={`min-height: ${CARD_MIN_HEIGHT.spotify}px; ${style ?? ''}`}
  data-tilt
  aria-busy="true"
>
  <CardEyebrow>Now playing</CardEyebrow>
  <div class="flex items-center gap-3">
    <CardSkeleton height={56} width="56px" radius="10px" />
    <div class="flex flex-1 flex-col gap-2">
      <CardSkeleton height={14} width="70%" />
      <CardSkeleton height={12} width="50%" />
    </div>
  </div>
  <div class="flex flex-col gap-2">
    <CardSkeleton height={4} radius="4px" />
    <CardSkeleton height={11} width="100%" class="opacity-50" />
  </div>
</Card>
